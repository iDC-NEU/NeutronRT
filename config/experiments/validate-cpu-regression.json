{
  "id": "cpu-regression-validation-v1",
  "hardware_profile": "peer-cpu",
  "wall_seconds": 300,
  "environment": {
    "CUDA_VISIBLE_DEVICES": "",
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MAX_JOBS": "1"
  },
  "command": [
    "{python}",
    "-m",
    "pytest",
    "tests/",
    "-m",
    "not host",
    "-q",
    "--tb=short"
  ]
}
