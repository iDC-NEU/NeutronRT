{
  "id": "arxiv-deferred-cpu-v1",
  "hardware_profile": "arxiv-cpu",
  "wall_seconds": 3600,
  "environment": {
    "CUDA_VISIBLE_DEVICES": "",
    "OMP_NUM_THREADS": "8",
    "MKL_NUM_THREADS": "8",
    "OPENBLAS_NUM_THREADS": "8"
  },
  "hash_files": [
    "examples/profiles/deferred-cpu.json",
    "/mnt/nfs0/lvhr/neutronrt-evaluation-data/checkpoints/sage-arxiv.pt"
  ],
  "command": [
    "{python}",
    "-m",
    "scripts.evaluate.profile",
    "--data",
    "/mnt/nfs0/lvhr/neutronrt-evaluation-data/arxiv/raw",
    "--cases",
    "examples/profiles/deferred-cpu.json",
    "--output",
    "{output}/report",
    "--checkpoint",
    "/mnt/nfs0/lvhr/neutronrt-evaluation-data/checkpoints/sage-arxiv.pt",
    "--model",
    "sage",
    "--classes",
    "40",
    "--hidden",
    "64",
    "--layers",
    "2",
    "--updates",
    "12",
    "--warmup",
    "3",
    "--changes",
    "16",
    "--queries",
    "128",
    "--repetitions",
    "5",
    "--threads",
    "8",
    "--worker-bytes",
    "4294967296",
    "--storage-bytes",
    "8589934592",
    "--timeout",
    "600",
    "--startup-timeout",
    "900"
  ]
}
